---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBottomNav from '@/components/MobileBottomNav.astro';
import OrganizationSchema from '@/components/schema/OrganizationSchema.astro';
import WebSiteSchema from '@/components/schema/WebSiteSchema.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
}

const { title, description, ogImage = '/og-default.jpg', canonical, type = 'website' } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = title.includes('MOST') ? title : `${title} · MOST Hrvatska`;
---

<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#003d7a" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
  <meta property="og:locale" content="hr_HR" />
  <meta property="og:site_name" content="MOST Hrvatska" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

  <!-- Hreflang -->
  <link rel="alternate" hreflang="hr-HR" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />

  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" as="style" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- Schema.org base -->
  <OrganizationSchema />
  <WebSiteSchema />

  <!-- AI crawler hints -->
  <link rel="alternate" type="text/plain" title="LLM-friendly index" href="/llms.txt" />
  <link rel="alternate" type="text/plain" title="LLM-friendly content" href="/llms-full.txt" />

  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main-content" class="skip-to-content">Preskoči na sadržaj</a>

  <Header />

  <main id="main-content" class="flex-1 pb-20 md:pb-0">
    <slot />
  </main>

  <Footer />
  <MobileBottomNav />
</body>
</html>
