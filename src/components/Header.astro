---
import Logo from '@/components/Logo.astro';
const navLinks = [
  { href: '/o-nama', label: 'O nama' },
  { href: '/clanovi', label: 'Zastupnici' },
  { href: '/policy', label: 'Što zastupamo' },
  { href: '/vijesti', label: 'Vijesti' },
  { href: '/lokalno', label: 'Lokalno' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center transition hover:opacity-80" aria-label="MOST — naslovnica">
        <Logo variant="color" width={104} />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Glavna navigacija">
        {navLinks.map((link) => (
          <a href={link.href} class="px-3 py-2 text-sm font-medium text-most-700 hover:text-accent-500 hover:bg-most-50 rounded-md transition">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTAs -->
      <div class="flex items-center gap-2 md:gap-3">
        <!-- ECR Party — član europske političke obitelji; klik otvara Reykjavik deklaraciju -->
        <a
          href="/ecr-reykjavik-deklaracija.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden lg:flex items-center gap-2 pr-3 mr-1 border-r border-slate-200 group"
          title="MOST je član ECR Party — pročitaj Reykjavik deklaraciju (PDF)"
          aria-label="ECR Party — Reykjavik deklaracija (otvara PDF u novom prozoru)"
        >
          <img src="/ecr-party-logo.jpg" width="34" height="34" alt="ECR Party" class="rounded-sm opacity-90 group-hover:opacity-100 transition" decoding="async" />
          <span class="hidden xl:inline text-[11px] leading-tight text-slate-600 group-hover:text-most-700 transition">Član<br>ECR Party</span>
        </a>
        <a href="/pridruzi-se" class="hidden sm:inline-flex btn-ghost text-sm">Pridruži se</a>
        <a href="/doniraj" class="btn-primary text-sm">Doniraj</a>

        <!-- Mobile menu button -->
        <button type="button" class="md:hidden p-2 text-most-700" aria-label="Otvori meni" data-mobile-menu-trigger>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div class="md:hidden border-t border-slate-200 bg-white hidden" data-mobile-menu>
    <nav class="px-4 py-4 space-y-1" aria-label="Mobilna navigacija">
      {navLinks.map((link) => (
        <a href={link.href} class="block px-3 py-3 text-base font-medium text-most-700 hover:bg-most-50 rounded-md">
          {link.label}
        </a>
      ))}
      <!-- ECR Party (mobile) -->
      <a href="/ecr-reykjavik-deklaracija.pdf" target="_blank" rel="noopener noreferrer"
         class="flex items-center gap-3 px-3 py-3 mt-2 border-t border-slate-100 text-sm text-slate-600">
        <img src="/ecr-party-logo.jpg" width="32" height="32" alt="ECR Party" class="rounded-sm" decoding="async" />
        <span>Član ECR Party — Reykjavik deklaracija (PDF)</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const trigger = document.querySelector('[data-mobile-menu-trigger]');
  const menu = document.querySelector('[data-mobile-menu]');
  trigger?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
