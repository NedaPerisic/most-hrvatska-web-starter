---
interface Props {
  name: string;
  slug: string;
  jobTitle: string;
  description: string;
  image: string;
  email?: string;
  sameAs?: string[];
  alumniOf?: string;
  birthDate?: string;
  birthPlace?: string;
}

const { name, slug, jobTitle, description, image, email, sameAs = [], alumniOf, birthDate, birthPlace } = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `https://most-hrvatska.hr/clanovi/${slug}#person`,
  name,
  jobTitle,
  description,
  image,
  url: `https://most-hrvatska.hr/clanovi/${slug}`,
  affiliation: { '@id': 'https://most-hrvatska.hr/#organization' },
  memberOf: { '@id': 'https://most-hrvatska.hr/#organization' },
  ...(email && { email }),
  ...(sameAs.length > 0 && { sameAs }),
  ...(alumniOf && { alumniOf: { '@type': 'EducationalOrganization', name: alumniOf } }),
  ...(birthDate && { birthDate }),
  ...(birthPlace && { birthPlace: { '@type': 'Place', name: birthPlace } }),
  nationality: { '@type': 'Country', name: 'Croatia' },
};
---

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
